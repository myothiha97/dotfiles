# Focus existing windows through Yabai so cross-Space switches bypass the
# native macOS animation. The helper launches the app when no window exists.
cmd + ctrl - h : /bin/sh "$HOME/.config/yabai/focus-app.sh" "Google Chrome"
cmd + ctrl - i : /bin/sh "$HOME/.config/yabai/focus-app.sh" "Safari"
cmd + ctrl - j : /bin/sh "$HOME/.config/yabai/focus-app.sh" "Ghostty"
cmd + ctrl - k : /bin/sh "$HOME/.config/yabai/focus-app.sh" "Finder"
# Slack is on M, not L: cmd + ctrl - l is left unbound here so it reaches
# Ghostty, where tmux opens a Claude pane (see ghostty/config, tmux/.tmux.conf).
cmd + ctrl - m : /bin/sh "$HOME/.config/yabai/focus-app.sh" "Slack"
cmd + ctrl - n : /bin/sh "$HOME/.config/yabai/focus-app.sh" "Obsidian"
cmd + ctrl - 0x29 : /bin/sh "$HOME/.config/yabai/focus-app.sh" "YouTube Music"
cmd + ctrl - o : /bin/sh "$HOME/.config/yabai/focus-app.sh" "IINA"
cmd + ctrl - u : /bin/sh "$HOME/.config/yabai/focus-app.sh" "Claude"
cmd + ctrl - 0x2B : /bin/sh "$HOME/.config/yabai/focus-app.sh" "Preview"
cmd + ctrl - w : /bin/sh "$HOME/.config/yabai/focus-app.sh" "Herdr"

# Window placement keys for every app, so any window can be placed without the
# mouse. They override what an app binds to them, on purpose: Cmd+Option+Left/
# Right no longer switch browser or VS Code tabs, Cmd+Shift+C is not Chrome's
# Inspect, Cmd+Shift+U is not Finder's Utilities.
#
# Cmd+Option+Arrows nudge the focused window 20 pt. In Ghostty this replaces its
# default goto_split, unused here since splits are tmux panes.
cmd + alt - left : /opt/homebrew/bin/yabai -m window --move rel:-20:0
cmd + alt - right : /opt/homebrew/bin/yabai -m window --move rel:20:0
cmd + alt - up : /opt/homebrew/bin/yabai -m window --move rel:0:-20
cmd + alt - down : /opt/homebrew/bin/yabai -m window --move rel:0:20
# Cmd+Shift+C puts the focused window back in the center of its display.
cmd + shift - c : /bin/sh "$HOME/.dotfiles/yabai/center-window.sh"
# Cmd+Shift+U toggles filling the display. Ghostty gets the key (~) for its own
# toggle_maximize, which also knows its configured compact size.
cmd + shift - u [
  "ghostty" ~
  * : /bin/sh "$HOME/.dotfiles/yabai/toggle-fill.sh"
]
