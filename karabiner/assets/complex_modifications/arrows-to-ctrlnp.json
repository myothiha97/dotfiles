 {
    "title": "Arrow Up/Down to Ctrl-P/Ctrl-N",
    "rules": [
      {
        "description": "Map Up Arrow to Ctrl-P and Down Arrow to Ctrl-N",
        "manipulators": [
          {
            "type": "basic",
            "from": {
              "key_code": "up_arrow"
            },
            "to": [
              {
                "key_code": "p",
                "modifiers": ["left_control"]
              }
            ]
          },
          {
            "type": "basic",
            "from": {
              "key_code": "down_arrow"
            },
            "to": [
              {
                "key_code": "n",
                "modifiers": ["left_control"]
              }
            ]
          }
        ]
      }
    ]
  }

