macos-option-as-alt = false

# macOS handles key repeat outside Ghostty's own config, and the effective
# knob is usually the global defaults domain rather than a Ghostty-only one.
# For faster held movement keys in Neovim, apply:
#   defaults write -g KeyRepeat -int 1
#   defaults write -g InitialKeyRepeat -int 10
# Go back to the macOS system default with:
#   defaults delete -g KeyRepeat
#   defaults delete -g InitialKeyRepeat
# Restart Ghostty after changing these values. If the change still does not
# show up, log out of macOS and back in once.

# window size
window-width = 160
window-height = 44

window-position-x = 300
window-position-y = 50

# background = 0a0a0a
# background = 1a1d24
# background = 001419
# background-blur = true

# copied from https://github.com/craftzdog/dotfiles-public/blob/master/.config/ghostty/config
# basically the same config as craftzdog's but with some tweaks to the colors and font size
background-opacity = 0.9
background-blur-radius = 20
background = #031219



# State
quick-terminal-position = center
quick-terminal-screen = main
quick-terminal-size = 75%,80%
window-save-state = never

# Keybinding for Quick Terminal
keybind = global:super+ctrl+l=toggle_quick_terminal
# Font
# font-family = Fira Code  # base fira code 
# font-family = "FiraCode Nerd Font"
# font-family =   MapleMono NF
font-family = "Maple Mono NF"
font-size = 12.5

# cursor
# cursor-style = block

# Cursor animation
cursor-style = block
cursor-style-blink = true
# cursor-color = 02b890
shell-integration-features = no-cursor
# cursor-text = a19f9f
# font-style-bold = "Bold"
# font-synthetic-style = bold

# Stroke weight. `font-thicken` is a macOS-only stroke thickening, and
# `font-thicken-strength` scales it from 0 to 255.
#
# CURRENT STATE: the strength line below is commented out on purpose, so the
# effective value is Ghostty's default of 255. Commenting it does NOT turn
# thickening off -- `font-thicken = true` is still set.
#
# History, in order:
#   255 -- once judged too heavy (thick, slightly blurred). That judgement was made
#       while the real problem was somewhere else entirely, see below. Re-judged on
#       2026-08-05 and it reads correct, so this is where the config sits again.
#   font-thicken = false (Ghostty's own default) -- too far the other way: strokes
#       go thin enough that text reads faded AND visually smaller at 13pt.
#   100 -- still thin and faded.
#   140 -- ran here for a while, then measured on 2026-08-05 rather than guessed.
#       Glyph pixels sampled from a screenshot: mean stroke coverage 0.386, so base0
#       #9eabac area-averaged to #3c4e51, L* 31.8. The same colour in Neovide covered
#       0.492 and landed at L* 38.7. A 6.9 L* gap on identical colour, i.e. purely a
#       rasterization difference, and the reason code read faded at 140.
#   165 -- recommended after that measurement, then superseded before it was ever
#       judged, because the measurement also showed the ACTUAL complaint was not
#       this dial at all.
#
# WHY THIS DIAL WAS BEING TOUCHED AT ALL, and why it should not be again:
# the thing that looked wrong was the CodeCompanion chat panel reading too bright.
# It was measured at effective L* 65.4 against 37.8 for the code text beside it,
# because that panel paints its prose with its own explicit colour. Lowering
# thickening did dim the chat by 10.1 L*, but it also cost 5.6 L* on ALL code text
# and every other terminal pane, to fix one panel worth ~25% of the screen. Wrong
# scope. It was fixed at its own layer instead: `CodeCompanionChatText` in
# lua/plugins/codecompanion.lua, which is already chat-scoped and costs nothing
# elsewhere. That freed this dial to go back to whatever suits code, which is 255.
#
# So: if ONE pane looks wrong, fix that pane. Only touch this dial when ALL text in
# the terminal is wrong. Ghostty has no text gamma/contrast correction of its own,
# so this really is the entire stroke-weight budget, which is exactly why it is too
# blunt for a single-panel problem. (Neovide looks fuller on the same theme because
# Skia applies its own gamma correction to text masks.) And note that raising the
# nvim palette is not the lever either: at 0.386 coverage a brighter base0 bought
# only ~2 L*. See `todos/syntax-palette-followups.md` item 4 in the nvim config.
font-thicken = true
# font-thicken-strength = 165
# Uncomment and adjust the line above only for a whole-terminal problem. It is a
# 0-255 dial: 180 and up starts softening glyph edges, 140 measured faded.
#
# Two other knobs, only if the strength dial alone can't get there:
#   * Thin strokes read as small type. One step up compensates without weight, and
#     would also match Neovide, which has been running at h14 all along:
#       font-size = 14
#   * Real weight change. "Maple Mono NF Light" and "Medium" are both installed:
#       font-style = Light
#     Avoid `alpha-blending = linear-corrected` for this: it thins bright text on
#     a dark background, which is the direction you already rejected.

clipboard-read = allow
clipboard-write = allow

# Rendering - sync frames to display refresh rate (reduces tearing)
window-vsync = true

# Ghostty's default auto-converts sRGB → P3 at shader level (best of both worlds).
# display-p3 reinterprets raw hex as P3 coordinates, which distorts sRGB colorschemes
# and breaks background-opacity on multi-monitor setups (macOS compositor issue).
window-colorspace = display-p3

# Send CSI u sequence for Ctrl+I to distinguish from Tab
keybind = ctrl+i=csi:105;5u

# Cmd+/ sends Alt+/ for commenting in Neovim (<M-/>)
keybind = super+slash=esc:/

# Cmd+Arrows send Shift+Arrows for window resize in Neovim
keybind = super+up=csi:1;2A
keybind = super+down=csi:1;2B
keybind = super+left=csi:1;2D
keybind = super+right=csi:1;2C
keybind = ctrl+k=unbind
keybind = ctrl+l=unbind

# Cmd+F sends Esc+f (passes through tmux to Neovim as <M-f> for LSP highlight)
keybind = super+f=esc:f

# Cmd+key sends Meta sequences for Neovim keymaps (since macos-option-as-alt is off)
keybind = super+d=esc:d
keybind = super+shift+l=esc:L
keybind = super+shift+]=esc:}
keybind = super+i=esc:i
keybind = super+w=esc:w
keybind = super+l=esc:l
keybind = super+]=esc:]
keybind = super+[=esc:[

